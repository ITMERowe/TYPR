<?xml version="1.0" encoding="utf-8"?>
<!--
  The one release build of TYPR: a single self-contained TYPR.exe for 64-bit Windows.
  Used by publish.ps1, build.yml and release.yml:  dotnet publish TYPR.csproj -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Pack the native runtime DLLs into the exe too, so TYPR.exe is the only file. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- WinForms is not trim-safe. -->
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <PublishDir>publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>

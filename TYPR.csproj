<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TYPR</AssemblyName>
    <RootNamespace>TYPR</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The test project lives under tests/ and must not be compiled into the app. -->
    <Compile Remove="tests/**" />
    <InternalsVisibleTo Include="TYPR.Tests" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TYPR</AssemblyName>
    <RootNamespace>TYPR</RootNamespace>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Local builds are 0.0.0; release.yml passes -p:Version from the vX.Y.Z tag. -->
    <Version>0.0.0</Version>
    <Product>TYPR</Product>
    <Company>ITMERowe</Company>
    <Authors>ITMERowe</Authors>
    <Description>Free, offline auto typer for Windows</Description>
    <Copyright>Copyright (c) ITMERowe</Copyright>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <!-- The test project lives under tests/ and must not be compiled into the app. -->
    <Compile Remove="tests/**" />
    <InternalsVisibleTo Include="TYPR.Tests" />
  </ItemGroup>
</Project>
